# Installed by deploy/bootstrap.sh; started daily by lapi-oauth-backup.timer.
# A copy of the database in /home/www/lapi/oauth/data/backups (the newest 14
# stay). Keys are not in it. Copy the folder off the server to survive a lost
# disk (docs/SERVER-BACKUPS.md).
[Unit]
Description=Back up the launcher accounts database

[Service]
Type=oneshot
User=lapi-oauth
Group=lapi-oauth
EnvironmentFile=/home/www/lapi/oauth/oauth.env
ExecStart=/home/www/lapi/oauth/current/lapi-oauth backup
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/www/lapi/oauth
BindPaths=/home/www/lapi/oauth/data
ReadWritePaths=/home/www/lapi/oauth/data
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=16
