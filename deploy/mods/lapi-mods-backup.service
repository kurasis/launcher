# Installed by deploy/bootstrap.sh; started daily by lapi-mods-backup.timer.
# A copy of the database in /home/www/lapi/mods/data/backups (the newest 14
# stay). The kept files are not in it: they stay in data/blobs and can be
# fetched again. Copy the folder off the server to survive a lost disk
# (docs/SERVER-BACKUPS.md).
[Unit]
Description=Back up the mods catalog database

[Service]
Type=oneshot
User=lapi-mods
Group=lapi-mods
EnvironmentFile=/home/www/lapi/mods/mods.env
ExecStart=/home/www/lapi/mods/current/lapi-mods backup
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/www/lapi/mods
BindPaths=/home/www/lapi/mods/data
ReadWritePaths=/home/www/lapi/mods/data
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=16
