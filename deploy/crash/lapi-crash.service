# Installed by deploy/bootstrap.sh as /etc/systemd/system/lapi-crash.service.
[Unit]
Description=Sferum launcher crash reports (crash.lapi.sh, D-061)
After=network.target

[Service]
User=lapi-crash
Group=lapi-crash
EnvironmentFile=/home/www/lapi/crash/crash.env
ExecStart=/home/www/lapi/crash/current/lapi-crash serve
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
# /home holds nothing else for it: only its own folder is there, its data writable.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/www/lapi/crash
BindPaths=/home/www/lapi/crash/data
ReadWritePaths=/home/www/lapi/crash/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# It only answers nginx on this server and calls nothing.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# What a network service needs; anything else fails with EPERM.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RemoveIPC=yes
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
