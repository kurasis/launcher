# Installed by deploy/bootstrap.sh; started daily by lapi-servers-backup.timer.
# A copy of the database in /home/www/lapi/servers/data/backups (the newest 14
# stay). Copy the folder off the server to survive a lost
# disk (docs/SERVER-BACKUPS.md).
[Unit]
Description=Back up the server ads database

[Service]
Type=oneshot
User=lapi-servers
Group=lapi-servers
EnvironmentFile=/home/www/lapi/servers/servers.env
ExecStart=/home/www/lapi/servers/current/lapi-servers backup
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/www/lapi/servers
BindPaths=/home/www/lapi/servers/data
ReadWritePaths=/home/www/lapi/servers/data
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=16
