# Installed by deploy/bootstrap.sh as /etc/systemd/system/lapi-skins.service.
[Unit]
Description=Sferum launcher skins and capes (skins.lapi.sh, D-065)
After=network.target lapi-oauth.service

[Service]
User=lapi-skins
Group=lapi-skins
EnvironmentFile=/home/www/lapi/skins/skins.env
ExecStart=/home/www/lapi/skins/current/lapi-skins serve
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
# /home holds nothing else for it: only its own folder is there, its data writable.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/www/lapi/skins
BindPaths=/home/www/lapi/skins/data
ReadWritePaths=/home/www/lapi/skins/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Out: the account service on this server only.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# What a network service needs; anything else fails with EPERM.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RemoveIPC=yes
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
