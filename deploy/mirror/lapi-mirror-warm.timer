# Installed by deploy/bootstrap.sh (D-062): warm the mirror 15 minutes after
# boot and every 6 hours; a run still going is not started twice.
[Unit]
Description=Warm the launcher download mirror every 6 hours

[Timer]
OnBootSec=15min
OnUnitActiveSec=6h
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
