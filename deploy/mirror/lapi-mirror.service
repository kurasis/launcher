# Installed by deploy/bootstrap.sh as /etc/systemd/system/lapi-mirror.service.
[Unit]
Description=Sferum launcher download mirror (mirror.lapi.sh, D-062)
After=network-online.target
Wants=network-online.target

[Service]
User=lapi-mirror
Group=lapi-mirror
EnvironmentFile=/home/www/lapi/mirror/mirror.env
ExecStart=/home/www/lapi/mirror/current/lapi-mirror serve
Restart=on-failure
RestartSec=3
# Kept files are public: nginx reads them.
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
# /home holds nothing else for it: only its own folder is there, its data writable.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/www/lapi/mirror
BindPaths=/home/www/lapi/mirror/data
ReadWritePaths=/home/www/lapi/mirror/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# What a network service needs; anything else fails with EPERM.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RemoveIPC=yes
CapabilityBoundingSet=
MemoryMax=1G
TasksMax=512
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
