# Installed by deploy/bootstrap.sh; started by lapi-mirror-warm.timer (D-062).
# Fetches what players will need into the mirror, through the running service.
[Unit]
Description=Warm the launcher download mirror (mirror.lapi.sh)
After=lapi-mirror.service
Requires=lapi-mirror.service

[Service]
Type=oneshot
User=lapi-mirror
Group=lapi-mirror
EnvironmentFile=/home/www/lapi/mirror/mirror.env
ExecStart=/home/www/lapi/mirror/current/lapi-mirror warm
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
MemoryMax=512M
