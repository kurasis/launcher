# Installed by deploy/bootstrap.sh; started daily by lapi-worlds-backup.timer.
# A copy of the database in /home/www/lapi/worlds/data/backups (the newest 14
# stay). The ticket key is not in it. Copy the folder off the server to survive a lost
# disk (docs/SERVER-BACKUPS.md).
[Unit]
Description=Back up the worlds with friends database

[Service]
Type=oneshot
User=lapi-worlds
Group=lapi-worlds
EnvironmentFile=/home/www/lapi/worlds/worlds.env
ExecStart=/home/www/lapi/worlds/current/lapi-worlds backup
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/www/lapi/worlds
BindPaths=/home/www/lapi/worlds/data
ReadWritePaths=/home/www/lapi/worlds/data
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=16
