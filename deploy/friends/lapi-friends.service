# Installed by deploy/bootstrap.sh as /etc/systemd/system/lapi-friends.service.
[Unit]
Description=Sferum launcher friends and chats (friends.lapi.sh, D-064)
After=network.target lapi-oauth.service

[Service]
User=lapi-friends
Group=lapi-friends
EnvironmentFile=/home/www/lapi/friends/friends.env
ExecStart=/home/www/lapi/friends/current/lapi-friends serve
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/www/lapi/friends/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Out: the account service on this server only.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
