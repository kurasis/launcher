{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main launcher window. Grant each new command explicitly. Lifecycle test commands have no handler in release builds.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-info",
    "allow-get-app-snapshot",
    "allow-create-instance",
    "allow-update-instance-settings",
    "allow-set-app-settings",
    "allow-show-main-window",
    "allow-request-quit",
    "allow-begin-login",
    "allow-cancel-login",
    "allow-sign-out",
    "allow-verify-account",
    "allow-open-external",
    "allow-list-supported-versions",
    "allow-preview-install-plan",
    "allow-install-instance",
    "allow-repair-instance",
    "allow-cancel-operation",
    "allow-launch-game",
    "allow-stop-game",
    "allow-start-lifecycle-test",
    "allow-stop-lifecycle-test"
  ]
}
