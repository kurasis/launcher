# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Rust / Tauri: src-tauri/.gitignore

# Local environment and editor files
.env
.env.*
*.local
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json
*.log
# Game output kept as crash analyser test fixtures (no tokens, neutral paths)
!src-tauri/src/launch/crash/fixtures/*.log

# Never commit game files, Java runtimes or user data
*.jar
*.part

# Local development data directory
.dev-data/
